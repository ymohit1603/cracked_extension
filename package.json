{
  "publisher": "MohitDev",
  "name": "CrackedDev",
  "displayName": "CrackedDev",
  "version": "0.8.3",
  "description": "CrackedDev vscode plugin",
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "icon": "images/logo.png",
  "engines": {
  "vscode": "^1.98.0"
}
,
  "activationEvents": [
    "onCommand:crackeddev.getToken",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "crackeddev.getToken",
        "title": "CrackedDev: Enter token"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "vscode:package": "vsce package",
    "vscode:publish": "vsce package && vsce publish",
    "compile": "webpack --devtool nosources-source-map --config ./build/node-extension.webpack.config.js",
    "watch": "webpack --watch --devtool nosources-source-map --config ./build/node-extension.webpack.config.js --stats-error-details",
    "package": "webpack --mode production --config ./build/node-extension.webpack.config.js ",
    "test-compile": "tsc -p ./",
    "test-watch": "tsc -watch -p ./",
    "pretest": "pnpm run test-compile && yarn run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "dependencies": {
    "@npmcli/fs": "^3.1.0",
    "@types/uuid": "^9.0.0",
    "@vscode/test-electron": "^2.2.3",
    "got": "^12.5.3",
    "os-name": "^5.1.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@jannchie/eslint-config": "^3.2.0",
    "@types/glob": "^8.0.1",
    "@types/mocha": "^10.0.1",
    "@types/node": "^18.11.19",
    "@types/vscode": "^1.98.0",
    "eslint": "^9.22.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "ts-loader": "^9.4.2",
    "typescript": "^4.9.5",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1"
  }
}
